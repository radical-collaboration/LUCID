{
    "run_description": {
        "resource": "bnl.ic2_csi",
        "project": "csihpc",
        "nodes": 1,
        "runtime": 60
    },

    "pipeline_cfg": {
        "input_dir": "/hpcgpfs01/scratch/mtitov/cell_painting_images/Images",
        "output_dir": "/hpcgpfs01/scratch/mtitov/cell_painting_images/output",
        "base_channel": "ch2",
        "target_channel": "ch3",
        "save_bbox": true,
        "bbox_threshold": 0.35, 
        "week_name": "week1",
        "plate_name": "plate8",
        "plate_config": "plate_experiments.json",
        "feature_type": "depth_maximize_pixel_avg"
    },

    "exec_cfg": {
        "task_pre_exec": [
            "conda deactivate || true",
            "module purge",
            "module load python/3.12-anaconda-2024.10",
            "eval \"$(conda shell.posix hook)\"",
            "conda activate ve.cellsam"
        ]
    }
}
